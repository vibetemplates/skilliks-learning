<?php
/**
 * Projects Page
 * 
 * Lists all projects with join functionality
 */

$page_title = 'Projects';
require_once 'includes/session.php';
require_once 'config/database.php';
require_once 'config/functions.php';
require_once 'classes/Project.php';
require_once 'classes/User.php';
require_once 'classes/Task.php';

// Require login
requireLogin();

$projectObj = new Project();

// Get all available skills for filter dropdown
try {
    $db = getDB();
    $stmt = $db->prepare("
        SELECT DISTINCT s.id, s.name, s.category 
        FROM skills s
        JOIN project_skills ps ON s.id = ps.skill_id
        WHERE s.is_active = 1
        ORDER BY s.category, s.name
    ");
    $stmt->execute();
    $availableSkills = $stmt->fetchAll();
} catch (PDOException $e) {
    $availableSkills = [];
}

// Handle project creation (if user has permission)
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action']) && $_POST['action'] === 'create') {
    $name = trim($_POST['name'] ?? '');
    $description = trim($_POST['description'] ?? '');
    $course_code = trim($_POST['course_code'] ?? '');
    $git_repository_url = trim($_POST['git_repository_url'] ?? '');
    
    if (empty($name)) {
        setFlashMessage('error', 'Project name is required.');
    } else {
        $data = [
            'name' => $name,
            'description' => $description,
            'course_code' => $course_code,
            'team_size_limit' => 10, // Keep default value for DB
            'git_repository_url' => $git_repository_url,
            'created_by' => getCurrentUserId()
        ];
        
        try {
            $projectId = $projectObj->create($data);
            if ($projectId) {
                setFlashMessage('success', 'Project created successfully!');
                header('Location: /project-detail.php?id=' . $projectId);
                exit;
            } else {
                setFlashMessage('error', 'Failed to create project.');
            }
        } catch (Exception $e) {
            setFlashMessage('error', 'Failed to create project: ' . $e->getMessage());
            error_log("Project creation exception: " . $e->getMessage());
        }
    }
}

// Pagination settings
$projectsPerPage = 5;
$activePage = max(1, (int)($_GET['active_page'] ?? 1));
$myPage = max(1, (int)($_GET['my_page'] ?? 1));
$pendingPage = max(1, (int)($_GET['pending_page'] ?? 1));

// Get current user ID
$currentUserId = getCurrentUserId();

// Get projects for each tab
$activeProjects = $projectObj->findActiveProjects($currentUserId);
$myProjects = $projectObj->findMyProjects($currentUserId);
$pendingProjects = $projectObj->findPendingProjects($currentUserId);

// Add skill IDs to each project for filtering
function addSkillIds(&$projects) {
    foreach ($projects as &$project) {
        try {
            $db = getDB();
            $stmt = $db->prepare("
                SELECT skill_id 
                FROM project_skills 
                WHERE project_id = ? AND importance_level = 'required'
            ");
            $stmt->execute([$project['id']]);
            $project['required_skill_ids'] = array_column($stmt->fetchAll(), 'skill_id');
        } catch (PDOException $e) {
            $project['required_skill_ids'] = [];
        }
    }
}

addSkillIds($activeProjects);
addSkillIds($myProjects);
addSkillIds($pendingProjects);

// Add user tasks to my projects
$taskObj = new Task();
foreach ($myProjects as &$project) {
    try {
        $db = getDB();
        $stmt = $db->prepare("
            SELECT t.id, t.title, t.status, t.priority, t.due_date
            FROM tasks t
            JOIN task_assignments ta ON t.id = ta.task_id
            WHERE t.project_id = ? AND ta.user_id = ? AND ta.unassigned_at IS NULL
            ORDER BY 
                CASE t.status 
                    WHEN 'in_progress' THEN 1
                    WHEN 'todo' THEN 2
                    WHEN 'done' THEN 3
                END,
                t.due_date ASC
            LIMIT 5
        ");
        $stmt->execute([$project['id'], $currentUserId]);
        $project['user_tasks'] = $stmt->fetchAll();
    } catch (PDOException $e) {
        $project['user_tasks'] = [];
    }
}

// Calculate pagination for active projects
$totalActiveProjects = count($activeProjects);
$totalActivePages = ceil($totalActiveProjects / $projectsPerPage);
$activeOffset = ($activePage - 1) * $projectsPerPage;
$paginatedActiveProjects = array_slice($activeProjects, $activeOffset, $projectsPerPage);

// Calculate pagination for my projects
$totalMyProjects = count($myProjects);
$totalMyPages = ceil($totalMyProjects / $projectsPerPage);
$myOffset = ($myPage - 1) * $projectsPerPage;
$paginatedMyProjects = array_slice($myProjects, $myOffset, $projectsPerPage);

// Calculate pagination for pending projects
$totalPendingProjects = count($pendingProjects);
$totalPendingPages = ceil($totalPendingProjects / $projectsPerPage);
$pendingOffset = ($pendingPage - 1) * $projectsPerPage;
$paginatedPendingProjects = array_slice($pendingProjects, $pendingOffset, $projectsPerPage);

// Fetch additional data for paginated projects
function fetchProjectData(&$projects, $projectObj) {
    foreach ($projects as &$project) {
        $project['recommended_courses'] = $projectObj->getRecommendedCourses($project['id']);
        $project['required_courses'] = $projectObj->getRequiredCourses($project['id']);
        if (!isset($project['skills'])) {
            $project['skills'] = $projectObj->getProjectSkills($project['id']);
        }
    }
}

fetchProjectData($paginatedActiveProjects, $projectObj);
fetchProjectData($paginatedMyProjects, $projectObj);
fetchProjectData($paginatedPendingProjects, $projectObj);

require_once 'includes/header.php';
?>

