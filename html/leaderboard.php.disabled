<?php
/**
 * Leaderboard Page
 * 
 * Shows community activity leaderboard
 */

$page_title = 'Leaderboard';
require_once 'includes/session.php';
require_once 'config/database.php';
require_once 'config/functions.php';

// Require login
requireLogin();

$communityId = getCurrentCommunityId();
$db = getDB();

// Get task completion leaderboard
$stmt = $db->prepare("
    SELECT 
        u.id,
        u.first_name,
        u.last_name,
        CONCAT(u.first_name, ' ', u.last_name) as name,
        u.profile_photo,
        COUNT(DISTINCT t.id) as completed_tasks,
        COUNT(DISTINCT f.id) as features_submitted,
        COUNT(DISTINCT c.id) as comments_made
    FROM users u
    JOIN community_members cm ON u.id = cm.user_id
    LEFT JOIN task_assignments ta ON u.id = ta.user_id
    LEFT JOIN tasks t ON ta.task_id = t.id AND t.status = 'done'
    LEFT JOIN features f ON u.id = f.submitted_by AND f.community_id = :community_id
    LEFT JOIN comments c ON u.id = c.user_id AND c.community_id = :community_id3
    WHERE cm.community_id = :community_id2
    AND cm.is_active = 1
    GROUP BY u.id
    ORDER BY completed_tasks DESC, features_submitted DESC, comments_made DESC
    LIMIT 20
");
$stmt->execute([
    ':community_id' => $communityId,
    ':community_id2' => $communityId,
    ':community_id3' => $communityId
]);
$leaderboard = $stmt->fetchAll();

require_once 'includes/header.php';
?>

<!-- Main content -->
<main class="container-fluid px-4">
